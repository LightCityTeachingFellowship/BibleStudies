---
layout: null
---
{% assign articles = site.pages | where: 'layout', 'articleTEMPLATE' %}
{% assign summaries = site.posts | where: 'layout', 'summaryTEMPLATE' %}
{% assign publications = articles | concat: summaries %}
{% capture video_markup %}{% include videosALL.html %}{% endcapture %}
{% assign video_lines = video_markup | strip_html | newline_to_br | split: '<br />' %}
{"posts":[{% for item in publications %}{"id":{{ item.url | jsonify }},"title":{{ item.title | jsonify }},"url":{{ item.url | relative_url | jsonify }},"kind":{% if item.layout == 'summaryTEMPLATE' %}"summary"{% else %}"article"{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}],"videos":[{% assign comma = '' %}{% for line in video_lines %}{% assign video_id = line | strip %}{% if video_id != '' %}{{ comma }}{"id":{{ video_id | prepend: 'video:' | jsonify }},"title":"New LightCity video","url":{{ '/Videos/' | relative_url | jsonify }},"kind":"video"}{% assign comma = ',' %}{% endif %}{% endfor %}]}
