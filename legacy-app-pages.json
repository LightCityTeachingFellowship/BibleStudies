---
layout: null
---
{% assign storylines = site.pages | where: 'layout', 'bibleStoryLineTEMPLATE' %}
{% assign creators = site.pages | where: 'layout', 'bibleStoryLineCREATOR' %}
{% assign graphs = site.pages | where: 'layout', 'bibleNodeGraph-1' %}
{% assign entries = storylines | concat: creators | concat: graphs %}
{% assign comma = '' %}
{"pages":[{%- for item in entries -%}{%- unless item.visibility == 'members' -%}{{ comma }}{"url":{{ item.url | relative_url | jsonify }},"title":{{ item.title | default: 'Bible study' | jsonify }}}{%- assign comma = ',' -%}{%- endunless -%}{%- endfor -%}]}
