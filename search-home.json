---
layout: null
---
{% assign articles = site.pages | where: 'layout', 'articleTEMPLATE' %}
{% assign summaries = site.posts | where: 'layout', 'summaryTEMPLATE' %}
{% assign publications = articles | concat: summaries %}
{% capture video_markup %}{% include videosALL.html %}{% endcapture %}
{% assign video_lines = video_markup | strip_html | newline_to_br | split: '<br />' %}
{
  "publications": [{% for item in publications %}{
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "kind": {% if item.layout == 'articleTEMPLATE' %}"Article"{% else %}"Summary"{% endif %},
    "categories": {{ item.categories | join: ' ' | jsonify }},
    "tags": {{ item.tags | join: ' ' | jsonify }},
    "text": {{ item.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}],
  "videoIds": [{% assign comma = '' %}{% for line in video_lines %}{% assign video_id = line | strip %}{% if video_id != '' %}{{ comma }}{{ video_id | jsonify }}{% assign comma = ',' %}{% endif %}{% endfor %}]
}
